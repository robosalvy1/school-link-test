# Public origin(s) of the separately hosted frontend. No wildcards.
CORS_ORIGINS=https://app.example.edu
DATABASE_URL=postgresql://schoollink:replace-with-a-long-random-password@postgres:5432/schoollink
NODE_ENV=production
PORT=8080
# Local email/password accounts are permitted from the exact origins above.
# Use HTTPS and a same-site static/API domain in production.
SESSION_COOKIE_NAME=school_link_session
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
SESSION_TTL_HOURS=168
# Set only when a trusted reverse proxy is immediately in front of the API.
TRUST_PROXY=1

# Used by Caddy in docker-compose.production.yml.
API_DOMAIN=api.example.edu
TLS_EMAIL=ops@example.edu
POSTGRES_DB=schoollink
POSTGRES_USER=schoollink
POSTGRES_PASSWORD=replace-with-a-long-random-password
