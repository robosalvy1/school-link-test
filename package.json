{
  "name": "school-link-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test test/moderation-security.test.js",
    "test:watch": "vitest",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "test:all": "npm test && npm run build && npm run server:test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
